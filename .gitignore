__pycache__/
*.pyc
.ipynb_checkpoints/

# competition data is not redistributed -- but keep the placeholder instructions
data/
!**/data/README.md

# large intermediate arrays
*.npy
out/_partial_*

# logs
*.log
.env

# engram artefacts that must never be committed (machine-local state).
# The ** prefix matters: a pattern with a slash is anchored, so plain
# `.engram/cache/` would miss <folder>/.engram/cache/ written by the post-commit hook.
**/.engram/branch.json
**/.engram/worktree.json
**/.engram/needs_update
**/.engram/cache/
.graphify/
